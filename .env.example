# Everything is optional. With nothing set, TotalTrip runs on SQLite, an in-memory cache,
# demo flight fares, estimated drive times and the offline rule-based assistant.

# Conversation (OpenAI Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Storage. Uncomment after `docker compose up -d`; the app won't start if these point at nothing.
# DATABASE_URL=postgresql+psycopg2://totaltrip:totaltrip@localhost:5432/totaltrip
# REDIS_URL=redis://localhost:6379/0

# Traffic-aware drive times (Google Routes API). Unset = distance-based estimates.
GOOGLE_MAPS_API_KEY=

FLIGHT_CACHE_TTL=900
SEARCHES_PER_HOUR=20
CORS_ORIGINS=http://localhost:3000

# Needed for /api/admin/*, which stays closed to everyone until this is set. Make one: openssl rand -hex 32
ADMIN_TOKEN=
# The tester codes you hand out, separated by commas. Trips with any other code don't count toward results.
TESTER_CODES=

# Limits for a public site. Each visitor gets these per hour.
TRIPS_PER_HOUR_PER_IP=30
MESSAGES_PER_HOUR_PER_IP=120
SEARCHES_PER_HOUR_PER_IP=60
# Tokens per day across everyone. Past this, chat uses the offline assistant until the next day.
LLM_TOKENS_PER_DAY=500000
MAX_REQUEST_BYTES=65536
# How many load balancers in front of the site add the visitor's address to X-Forwarded-For.
# At 0, all visitors share ONE set of limits. That can't be faked, but a group of testers can use it up.
# Next.js doesn't count: it passes on whatever the visitor sent.
# Above 0, set it to match your hosting, and keep the API port private, or visitors can fake an address to dodge limits.
TRUSTED_PROXY_HOPS=0
